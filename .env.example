# Copy to .env for local development only. Never commit a filled-in .env.
#
# In a deployed Databricks App the connection URL is NOT read from here: it
# comes from the Databricks secret named by LAKEBASE_SECRET_SCOPE /
# LAKEBASE_SECRET_KEY (see app.yaml and setup_secrets.py).

LAKEBASE_URL=postgresql://<role>:<password>@<instance>.database.cloud.databricks.com:5432/databricks_postgres?sslmode=require

# Needed for local development even though LAKEBASE_URL is set directly above
# -- embeddings come from a Databricks Model Serving endpoint over REST, so
# the process still needs to authenticate to your workspace to call it. Skip
# these two if you already have a working `databricks auth login` profile or
# a populated ~/.databrickscfg; the SDK picks those up automatically.
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=<a personal access token>

# The National Weather Service asks every client to identify itself with a
# contact address. This is the only "credential" the data source needs.
NWS_USER_AGENT=weather-intelligence-app (your.email@example.com)

# Optional overrides.
WEATHER_DOCUMENTS_TABLE=weather_documents
WEATHER_EMBEDDINGS_TABLE=weather_embeddings

# databricks-gte-large-en (1024-dim) is a pre-configured Foundation Model API
# endpoint, called over REST -- no local model, no torch. Requires that the
# Databricks SDK can authenticate (see below). On classic, non-serverless
# compute you can instead set this to a local sentence-transformers model
# name, e.g. sentence-transformers/all-MiniLM-L6-v2 -- see config.py.
EMBEDDING_MODEL=databricks-gte-large-en
CHUNK_SIZE=800
CHUNK_OVERLAP=100
WEATHER_LOCATIONS=Chicago, IL;Austin, TX;Denver, CO;Miami, FL;Seattle, WA

# Optional: a Databricks model serving endpoint for the RAG summary on
# GET /weather/search?summarize=true. Leave blank to disable summaries.
SUMMARY_MODEL_ENDPOINT=
